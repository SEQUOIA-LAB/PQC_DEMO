# Python
.venv/
__pycache__/
*.pyc

# Demo certs ARE committed (throwaway demo CA so both Pis trust the same root
# from a plain `git pull` — see deploy/deploy.sh). Ignore only the transient
# build artifacts within certs/, not the certs themselves.
certs/*.csr
certs/*.ext
certs/*.srl
# classical comparison certs are regenerated by metrics/ (do not commit)
certs/classical*
# per-algorithm certs (certs/algs/<id>/) ARE committed so both Pis trust the
# same CA for a selected algorithm; only their transient build artifacts are not
certs/algs/**/*.csr
certs/algs/**/*.ext
certs/algs/**/*.srl

# Runtime artifacts (events, keylogs, metrics)
runs/

# Build artifacts
/tmp/
*.keylog
